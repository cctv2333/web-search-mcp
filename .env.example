# ===== Web 搜索与阅读 MCP 环境变量示例 =====
# 复制为 .env 或在系统/进程环境里设置；密钥绝不写入代码/文档/日志。

# ---- 可选搜索源密钥（不设则对应源自动不可用，ws_search 仍走 Bing）----
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
BOCHA_API_KEY=sk-xxxxxxxxxxxxxxxx
# 博查 API 基址（默认 https://api.bochaai.com；若官方换用 api.bocha.cn 可在此覆盖）
# BOCHA_BASE_URL=https://api.bocha.cn

# ---- 抓取纪律 ----
# 请求头 User-Agent（如实标识用途，方便站长联系；别伪装浏览器）
WS_USER_AGENT=WebSearchMCP/0.1 (personal research assistant; no tracking; low volume)
# 是否尊重 robots.txt：1 尊重（默认）/ 0 关闭
WS_ROBOTS=1
# 同一主机两次请求最小间隔秒（限速）
WS_MIN_INTERVAL=1.0
# 单次请求超时秒
WS_TIMEOUT=15.0
# 单次响应读取上限字节（默认 2MB）
WS_MAX_RESP_BYTES=2097152
# 单页正文输出上限字符（默认 60000）
WS_MAX_PAGE_CHARS=60000
# ws_read 多页阅读最多翻几页（默认 5）
WS_MAX_PAGES=5
# 多页续读策略：page=只信数字页码分页（默认，最稳）；any=额外跟随 rel=next/下一页锚点（会把相邻文章连读，慎用）
WS_PAGING_MODE=page
# 结果核验：是否回访 TopN 条确认存活与标题一致（0=关, 1=只核验前3条）
WS_VERIFY=1
# 浏览器渲染兜底：auto=静态+RSS失败才调本机 Edge/Chrome 无头渲染（默认）；off=关闭；on=遇JS页即用。
# 也可用 WS_BROWSER_PATH 显式指定浏览器可执行文件路径。
WS_BROWSER_MODE=auto
# WS_BROWSER_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
